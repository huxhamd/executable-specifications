<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything below the specs: the spec base, DSLs, drivers and channels.
    Specs live in ../acceptance.Specs and see only what's public here, so
    they can reach the system only through the DSL.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- xUnit's library for extensions, not its test runner: this project holds no tests. -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.0" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.0" />
  </ItemGroup>

  <!--
    No global `using Xunit;` here, on purpose. Only the files that should give
    verdicts or hook into xUnit declare it: the DSLs, the spec base and the
    Channels attribute. In a driver, `using Xunit;` or
    `using static Microsoft.Playwright.Assertions;` means a verdict has crept
    into the wrong layer: drivers report, the DSL decides.
  -->

</Project>
