<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Playwright is for the drivers alone. PrivateAssets keeps NuGet's default
      (contentfiles;analyzers;build) and adds compile, so the projects above
      can't compile against Playwright. Runtime, native and buildTransitive
      assets still flow, so the specs get the assembly and the browser driver
      in their output.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1"
                      PrivateAssets="compile;contentfiles;analyzers;build" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Todo.Acceptance.Dsl" />
  </ItemGroup>

  <!--
    No xUnit here, on purpose: drivers report what they see, and the DSL
    decides whether that passes, so Assert doesn't exist in this project.
    Playwright's own assertions do, because they ship in the package the
    drivers need: `using static Microsoft.Playwright.Assertions;` in a driver
    means a verdict has crept into the wrong layer.
  -->

</Project>
