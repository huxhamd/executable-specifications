{
  "permissions": {
    "deny": [
        "Edit(/acceptance/**)",
        "Edit(/.claude/settings.json)",
        "Edit(/scripts/check-guardrails.ps1)",
        "Edit(/scripts/acceptance.ps1)"
    ],
    "ask": [
        "Edit(/CLAUDE.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
